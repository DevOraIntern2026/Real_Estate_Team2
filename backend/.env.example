# Application Configuration
PORT=3000
NODE_ENV=dev

# Database Configuration (MongoDB)
DB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/devora

# Redis Configuration (Cache & Session Store)
REDIS_URL=redis://localhost:6379

# Google Mail (SMTP for Email Verification & OTP)
GOOGLE_EMAIL=your-email@gmail.com
GOOGLE_APP_PASSWORD=your-google-app-password

# Google OAuth2
WEB_CLIENT_ID=your-google-web-client-id

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# JWT Secret Keys
CUSTOMER_TOKEN_SECRET_KEY=customer_jwt_secret_example
OWNER_TOKEN_SECRET_KEY=owner_jwt_secret_example
ADMIN_TOKEN_SECRET_KEY=admin_jwt_secret_example
AGENT_TOKEN_SECRET_KEY=agent_jwt_secret_example

# Refresh Token Secret Keys
CUSTOMER_REFRESH_TOKEN_SECRET_KEY=customer_refresh_secret_example
OWNER_REFRESH_TOKEN_SECRET_KEY=owner_refresh_secret_example
ADMIN_REFRESH_TOKEN_SECRET_KEY=admin_refresh_secret_example
AGENT_REFRESH_TOKEN_SECRET_KEY=agent_refresh_secret_example

# Token Expiration Settings
ACCESS_TOKEN_EXPIRATION_TIME=1h
REFRESH_TOKEN_EXPIRATION_TIME=7d
REFRESH_ROTATION_GRACE_SECONDS=30
INVITE_SECRET=invite_secret_example

# Security & Encryption Settings
SALT_ROUND=10
ENCRYPTION_BYTE=12345678901234567890123456789012
IV_LENGTH=16

# AI Assistant Configuration
AI_PROVIDER=openrouter
AI_API_KEY=your_openrouter_api_key_here
AI_MODEL=openai/gpt-4o-mini
AI_BASE_URL=https://openrouter.ai/api/v1
AI_TIMEOUT_MS=10000

